# USB Wi-Fi adapters (built-in, plug and play)

# Core wireless stack (required for all Wi-Fi drivers below)
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y

# Re-open vendor menus closed by gki_defconfig (without these the
# drivers below are silently dropped during defconfig resolution)
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_WLAN_VENDOR_ZYDAS=y

# Ralink/MediaTek rt2x00 USB family (RT2870/RT3070/RT5370/RT5572...)
CONFIG_RT2X00=y
CONFIG_RT2500USB=y
CONFIG_RT73USB=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y

# Realtek USB dongles
CONFIG_RTL8187=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y

# Atheros USB dongles
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_AR5523=y

# ZyDAS/ZyDAS-based and wireless RNDIS gadgets
CONFIG_ZD1211RW=y
CONFIG_USB_ZD1201=y
CONFIG_USB_NET_RNDIS_WLAN=y
