# USB network adapters (built-in, plug and play)
CONFIG_USB=y
CONFIG_USB_USBNET=y

# Wired: CDC standards (phone tethering, routers, dongles)
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_RNDIS_HOST=y

# Wired: common USB NICs
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y
CONFIG_USB_LAN78XX=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_DM9601=y
CONFIG_USB_NET_MCS7830=y

# Wired: cellular modems and iPhone ethernet
CONFIG_USB_NET_QMI_WWAN=y
CONFIG_USB_SIERRA_NET=y
CONFIG_USB_IPHETH=y

# Wireless core stack (required for Wi-Fi dongles)
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y

# Wireless: Realtek USB dongles
CONFIG_RTL8187=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y

# Wireless: Ralink/MediaTek rt2x00 USB family
CONFIG_RT2X00=y
CONFIG_RT2500USB=y
CONFIG_RT73USB=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y

# Wireless: Atheros USB dongles
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_AR5523=y

# Wireless: ZyDAS dongles and wireless RNDIS gadgets
CONFIG_ZD1211RW=y
CONFIG_USB_ZD1201=y
CONFIG_USB_NET_RNDIS_WLAN=y
