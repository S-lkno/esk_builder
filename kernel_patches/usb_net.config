# 开启所有 USB 无线网卡驱动（按厂商分组）
CONFIG_USB_NET_RNDIS_WLAN=y      # 部分安卓热点
CONFIG_RT2X00_USB=y              # Ralink/MTK全系列USB
CONFIG_RTL8187=y                 # 经典老卡
CONFIG_RTL8XXXU=y                # 现代Realtek USB
CONFIG_ATH9K_HTC=y               # Atheros USB
CONFIG_CARL9170=y                # Atheros另一个分支
CONFIG_ZD1211RW=y                # 早期ZyDAS
CONFIG_AR5523=y                  # Atheros早期
CONFIG_USB_ZD1201=y              # 老款
# 核心依赖（必须开启，否则上面无效）
CONFIG_CFG80211=y
CONFIG_MAC80211=y
